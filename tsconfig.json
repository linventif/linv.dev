{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "types": ["astro/client", "node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  }
}
